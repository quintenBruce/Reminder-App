rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_OWNER_UID';
    }
    match /users/{uid}/{document=**} {
      allow read: if owner() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
